<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:HabitTracker.Mobile.Pages"
       x:Class="HabitTracker.Mobile.AppShell">

    <TabBar>
        <Tab Title="Habits">
            <ShellContent ContentTemplate="{DataTemplate pages:HabitsPage}"
                          Route="HabitsPage" />
        </Tab>
        <Tab Title="Stats">
            <ShellContent ContentTemplate="{DataTemplate pages:StatsPage}"
                          Route="StatsPage" />
        </Tab>
    </TabBar>

</Shell>
